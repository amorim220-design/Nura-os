#!/usr/bin/python3 -IB
"""Ajusta apenas o backlight do painel pelo sysfs."""
import re
import sys
from pathlib import Path


def main():
    if len(sys.argv) != 3:
        return 2
    device, value = sys.argv[1:]
    if not re.fullmatch(r"[A-Za-z0-9_.:-]{1,128}", device) or device in (".", ".."):
        return 2
    if not re.fullmatch(r"[0-9]{1,10}", value):
        return 2
    try:
        path = (Path("/sys/class/backlight") / device).resolve(strict=True)
        if not path.is_relative_to("/sys/devices"):
            return 2
        maximum = int((path / "max_brightness").read_text())
        level = int(value)
        if not 1 <= level <= maximum:
            return 2
        (path / "brightness").write_text(str(level) + "\n")
    except (OSError, ValueError) as exc:
        print(str(exc), file=sys.stderr)
        return 1
    return 0


raise SystemExit(main())
